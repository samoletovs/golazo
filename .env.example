# ──────────────────────────────────────────────────────────────────────
# golazo Environment Variables
#
# Copy to .env for local development.
# In production, set via Azure SWA App Settings.
# ──────────────────────────────────────────────────────────────────────

# ── Application Insights (optional) ──
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Cosmos DB (API backend) ──
COSMOS_ENDPOINT=

# -- Azure OpenAI (optional AI Coach) --
# Both endpoint and key are required; otherwise coaching stays unconfigured.
# An absent or empty deployment setting also defaults to gpt-6-luna.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna

# ── YouTube Data API v3 (exercise video enrichment) ──
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
# Free tier: 10,000 queries/day
YOUTUBE_API_KEY=

# ── Telegram Notifications (track-login) ──
TELEGRAM_NOTIFY_URL=
