{
  "name": "golazo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "validate:football-terms": "node scripts/validate-football-terminology.cjs",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "maintain": "node scripts/maintenance/maintain.cjs",
    "maintain:dry": "node scripts/maintenance/maintain.cjs --dry-run --verbose",
    "maintain:full": "node scripts/maintenance/maintain.cjs --full --verbose",
    "maintain:scan": "node scripts/maintenance/maintain.cjs --task federation --verbose",
    "maintain:health": "node scripts/maintenance/maintain.cjs --task health --verbose",
    "maintain:i18n": "node scripts/maintenance/maintain.cjs --task i18n --verbose",
    "maintain:exercises": "node scripts/maintenance/maintain.cjs --task exercise --verbose",
    "maintain:teams": "node scripts/maintenance/maintain.cjs --task team-registry --verbose"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.7.4",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
